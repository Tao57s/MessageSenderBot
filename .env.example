# ============================================
# ОБЩИЕ НАСТРОЙКИ
# ============================================

# URL для подключения к PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_db

# Включение/отключение ботов (true/false)
ENABLE_TELEGRAM_BOT=true
ENABLE_MAX_BOT=true
ENABLE_VK_BOT=true
# ============================================
# TELEGRAM БОТ
# ============================================

# Токен Telegram бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ваш ID в Telegram (можно узнать у @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# Прокси (опционально)
PROXY_URL=socks5://proxy_ip:port

# ============================================
# MAX БОТ
# ============================================

# Токен для API Max
MAX_BOT_TOKEN=your_max_bot_token_here

# Ваш ID в Max
ADMIN_MAX_ID=123456789

# URL API Max (если отличается)
MAX_API_URL=https://platform-api2.max.ru/me

# ============================================
# VK БОТ
# ============================================

# Токен группы VK (получить в настройках сообщества)
VK_GROUP_TOKEN=your_vk_group_token_here

# Ваш ID в VK
ADMIN_VK_ID=123456789

# Версия API VK
VK_API_VERSION=5.199

# ID сообщества VK (получить в настройках сообщества или через API)
VK_GROUP_ID=123456789
